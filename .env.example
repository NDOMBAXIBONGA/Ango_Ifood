# ==============================================================================
# DJANGO CORE SETTINGS
# ==============================================================================
DJANGO_SECRET_KEY=altere-esta-chave-secreta-em-producao-com-pelo-menos-50-caracteres-aleatorios
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.seudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.seudominio.com,https://app.seudominio.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.seudominio.com
DJANGO_TIME_ZONE=Europe/Lisbon
DJANGO_LANGUAGE_CODE=pt-pt
DJANGO_LOG_LEVEL=INFO

# ==============================================================================
# DATABASE (PostgreSQL + PostGIS)
# ==============================================================================
# Formato: postgis://UTILIZADOR:PASSWORD@HOST:PORTA/NOME_BD
DATABASE_URL=postgis://delivery_user:delivery_pass@127.0.0.1:5432/delivery_db
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=False

# Caminhos opcionais para binários C do GeoDjango (necessário apenas se não estiverem no PATH padrão do SO)
# GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so
# GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so

# ==============================================================================
# REDIS, CELERY & DJANGO CHANNELS
# ==============================================================================
# DB 0: Celery Broker | DB 1: Celery Result Backend | DB 2: Django Channels | DB 3: Django Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CHANNEL_LAYERS_REDIS_URL=redis://127.0.0.1:6379/2
REDIS_CACHE_URL=redis://127.0.0.1:6379/3

# ==============================================================================
# JWT AUTHENTICATION (SimpleJWT)
# ==============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# ==============================================================================
# SECURITY / HTTPS (Produção)
# ==============================================================================
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
