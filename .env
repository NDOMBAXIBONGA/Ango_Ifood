# ==============================================================================
# CONFIGURAÇÕES LOCAIS DE DESENVOLVIMENTO (.env)
# ==============================================================================
DJANGO_SECRET_KEY=django-insecure-delivery-local-development-secret-key-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
DJANGO_TIME_ZONE=Africa/Luanda
DJANGO_LANGUAGE_CODE=pt-pt
DJANGO_LOG_LEVEL=INFO

# ==============================================================================
# BASE DE DADOS (PostgreSQL + PostGIS)
# ==============================================================================
DATABASE_URL=postgis://postgres:postgres@127.0.0.1:5432/delivery_db
DB_CONN_MAX_AGE=0
DB_SSL_REQUIRE=False

# ==============================================================================
# REDIS, CELERY & DJANGO CHANNELS
# ==============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CHANNEL_LAYERS_REDIS_URL=redis://127.0.0.1:6379/2
REDIS_CACHE_URL=redis://127.0.0.1:6379/3

# ==============================================================================
# AUTENTICAÇÃO JWT (SimpleJWT)
# ==============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# ==============================================================================
# SEGURANÇA LOCAL (DESATIVADA EM DEBUG)
# ==============================================================================
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# ==============================================================================
# GEODJANGO (GDAL & GEOS NO WINDOWS)
# ==============================================================================
GDAL_LIBRARY_PATH=C:\Program Files\MySQL\MySQL Workbench 8.0\gdal.dll
GEOS_LIBRARY_PATH=C:\Users\N.M.A.B\Desktop\PC\PROGRAMAÇÃO\Django_Documanteção\Delivery\venv\Lib\site-packages\shapely.libs\geos_c-6dd9fd915eef8a7928285416bef1e666.dll

